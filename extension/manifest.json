{
  "manifest_version": 3,
  "name": "Session Control for ChatGPT",
  "version": "0.2.0",
  "description": "Боковая панель для контроля открытых чатов ChatGPT: статусы, непрочитанные ответы, локальные названия и уведомления.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "notifications",
    "tabGroups"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть Session Control for ChatGPT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-next-unread": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Открыть следующий непрочитанный ответ ChatGPT"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
